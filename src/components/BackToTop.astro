---
// A small round button at the bottom right, shown once the page has scrolled more than a screen.
// Without JavaScript it never shows.
---

<button type="button" class="to-top" aria-label="Back to top" title="Back to top">
  <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
    <path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.to-top');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let queued = false;

  function update() {
    queued = false;
    button?.classList.toggle('shown', window.scrollY > window.innerHeight);
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!queued) requestAnimationFrame(update);
      queued = true;
    },
    { passive: true },
  );
  update();

  button?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    // The button hides at the top, so keyboard focus moves to the logo instead of getting lost: the sidebar's
    // or the top bar's, whichever is shown.
    [...document.querySelectorAll<HTMLElement>('.home')].find((home) => home.offsetParent !== null)?.focus({ preventScroll: true });
  });
</script>

<style>
  .to-top {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 10;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--card);
    color: var(--text);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.15);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.2s,
      transform 0.2s,
      visibility 0.2s;
  }

  .to-top.shown {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .to-top {
      transition: none;
    }
  }
</style>
