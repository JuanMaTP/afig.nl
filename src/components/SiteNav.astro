---
// The site's navigation, by category (src/lib/navigation.ts), and the account below it: in the sidebar on wide
// screens, and in the menu panel on phones (docs/brand/design-direction.md, Navigation and account). Each entry
// has its icon; tools for members carry a lock while signed out; the hosts' category shows only to hosts, with
// what waits for them.
import { initialOf, type Member } from '../lib/auth';
import type { NavGroup, NavItem } from '../lib/navigation';
import MembersLock from './MembersLock.astro';
import NavIcon from './NavIcon.astro';

interface Props {
  groups: NavGroup[];
  current: NavItem | null;
  member: Member | null;
  counts: { openTips: number; newFilms: number } | null;
  /** Where "Sign in" goes: the sign-in page, then back to this page. */
  signIn: string;
  /** Tells the two copies apart (the sidebar's and the menu's), for their ids. */
  id: string;
}

const { groups, current, member, counts, signIn, id } = Astro.props;
---

<nav class="site-nav" aria-label="Site">
  {
    groups.map((group) => (
      <div class="group">
        <p class="heading" id={`${id}-${group.key}`}>
          {group.label}
        </p>
        <ul aria-labelledby={`${id}-${group.key}`}>
          {group.items.map((item) => {
            const badge = item.badge && counts ? counts[item.badge] : 0;
            return (
              <li>
                <a href={item.href} aria-current={item === current ? 'page' : undefined}>
                  <NavIcon name={item.icon} />
                  <span class="label">{item.label}</span>
                  {group.audience === 'members' && !member && (
                    <span class="lock">
                      <MembersLock />
                    </span>
                  )}
                  {badge > 0 && (
                    <span class="badge">
                      {badge}
                      <span class="visually-hidden"> new</span>
                    </span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>

<div class="account">
  {
    member ? (
      <div class="card">
        <span class="initial" aria-hidden="true">
          {initialOf(member)}
        </span>
        <span class="names" title={`${member.name} · ${member.email}`}>
          <span class="name">{member.name}</span>
          <span class="email">{member.email}</span>
        </span>
        <form method="post" action="/auth/sign-out">
          <button type="submit" title="Sign out">
            <NavIcon name="sign-out" />
            <span class="visually-hidden">Sign out</span>
          </button>
        </form>
      </div>
    ) : (
      <>
        <a href={signIn} class="sign-in">
          Sign in
        </a>
        <p class="why">For the tools: the Film finder and Recommend.</p>
      </>
    )
  }
</div>

<style>
  .site-nav {
    display: grid;
    gap: 24px;
  }

  .heading {
    margin: 0 0 6px;
    padding: 0 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* An entry: icon, word, then the lock or the count at the far end. */
  a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
  }

  .label {
    flex: 1;
  }

  a :global(.nav-icon) {
    color: var(--muted);
  }

  a:hover {
    background: var(--pill);
  }

  /* The current page: a card, with the accent at its edge and on its icon. */
  a[aria-current='page'] {
    background: var(--card);
    box-shadow:
      inset 3px 0 0 var(--accent),
      inset 0 0 0 1px var(--line);
    font-weight: 600;
  }

  a[aria-current='page'] :global(.nav-icon) {
    color: var(--accent);
  }

  .lock {
    display: inline-flex;
    color: var(--muted);
  }

  .badge {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 11px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12px;
    font-weight: 600;
  }

  .account {
    margin-top: 28px;
  }

  /* Signed in: one row, the initial, the name and email, and Sign out as an icon button. */
  .card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 4px 8px 10px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
  }

  /* In the wordmark's colours: Pith on Navy in Daylight, Night on Pith in Screening room. */
  .initial {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--wordmark);
    color: var(--bg);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
  }

  .names {
    display: grid;
    flex: 1;
    min-width: 0;
    line-height: 1.3;
  }

  .name,
  .email {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .name {
    font-size: 14px;
    font-weight: 600;
  }

  .email {
    font-size: 12px;
    color: var(--muted);
  }

  form {
    margin: 0;
  }

  button {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  button:hover {
    background: var(--pill);
    color: var(--accent);
  }

  .sign-in {
    justify-content: center;
    min-height: 44px;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .sign-in:hover {
    background: var(--accent);
    opacity: 0.9;
  }

  .why {
    margin: 8px 4px 0;
    font-size: 12px;
    line-height: 1.4;
    color: var(--muted);
  }
</style>
