---
// The agenda's month view: one grid per month, weeks from Monday. A day with events shows each event's
// still, one band per event (titles with their times too on wider screens), and links to that day in
// the list, where the details are.
import { coverImageSources, formatDay, formatTime } from '../lib/format';
import type { GridDay, MonthGrid } from '../lib/month-grid';

interface Props {
  months: MonthGrid[];
}

const { months } = Astro.props;
const WEEKDAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
/** Bands a cell can show; more events than that show as "+1". */
const MAX_BANDS = 3;

/** What a screen reader says for a day: "Sat 10 Oct: Digger + 2nd Anniversary Celebration, meet 17:00". */
function dayLabel(day: GridDay): string {
  const events = day.events.map((e) => `${e.title}${e.cancelled ? ' (cancelled)' : ''}, meet ${formatTime(e.startsAt)}`);
  return `${formatDay(day.events[0]!.startsAt)}: ${events.join('; ')}`;
}

/** One band per event, up to MAX_BANDS. */
function bands(day: GridDay): { src: string | null; cancelled: boolean }[] {
  return day.events.slice(0, MAX_BANDS).map((e) => ({
    // The 600 px image the list view loads too, so it usually comes from the cache. Meetup's
    // thumbnail is 80 × 45 px, too small for a phone's screen.
    src: e.coverImageUrl ? coverImageSources(e.coverImageUrl).src : null,
    cancelled: e.cancelled,
  }));
}
---

<p class="hint">Pick a day to see its events.</p>
{
  months.map((month) => (
    <section class="month" aria-labelledby={`month-${month.key}`}>
      <h2 id={`month-${month.key}`}>{month.label}</h2>
      <div class="grid">
        {WEEKDAYS.map((weekday) => (
          <span class="weekday" aria-hidden="true">
            {weekday}
          </span>
        ))}
        {month.weeks.flat().map((day) => {
          if (!day) return <span class="cell blank" />;
          const classes = ['cell', { today: day.isToday, past: day.isPast }];
          if (day.events.length === 0) {
            return (
              <span class:list={classes}>
                <span class="number">{day.day}</span>
              </span>
            );
          }
          return (
            <a class:list={[...classes, 'has-events']} href={`/#day-${day.key}`} aria-label={dayLabel(day)}>
              <span class="picture">
                {bands(day).map((band) => (
                  <span class:list={['band', { off: band.cancelled }]}>
                    {band.src && <img src={band.src} alt="" loading="lazy" decoding="async" />}
                  </span>
                ))}
              </span>
              <span class="number">{day.day}</span>
              {day.events.length > MAX_BANDS && <span class="count">+{day.events.length - MAX_BANDS}</span>}
              <span class="titles">
                {day.events.map((e) => (
                  <span class:list={{ off: e.cancelled }}>
                    <time datetime={e.startsAt}>{formatTime(e.startsAt)}</time> {e.title}
                  </span>
                ))}
              </span>
            </a>
          );
        })}
      </div>
    </section>
  ))
}

<style>
  .hint {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  .month h2 {
    margin: 22px 0 10px;
    font-family: var(--font-title);
    font-weight: 400;
    font-size: 21px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
  }

  .weekday {
    padding-bottom: 2px;
    font-size: 12px;
    text-align: center;
    color: var(--muted);
  }

  .cell {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1.15;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    color: var(--text);
    text-decoration: none;
  }

  .cell.blank {
    border: 0;
    background: none;
  }

  .cell.past {
    opacity: 0.45;
  }

  /* Above the still, so today stays marked on a day with events. */
  .cell.today::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px var(--accent);
    pointer-events: none;
  }

  .number {
    position: absolute;
    top: 4px;
    left: 5px;
    font-size: 13px;
    color: var(--muted);
  }

  .has-events .number {
    top: 3px;
    left: 3px;
    padding: 0 4px;
    border-radius: 4px;
    font-weight: 600;
    background: var(--tag);
    color: var(--tag-text);
  }

  /* The bands stack on a phone and sit side by side on wider screens; the gap shows the card colour. */
  .picture {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--card);
  }

  .band {
    flex: 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
    background: var(--still);
  }

  .band img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .band.off {
    filter: grayscale(1);
    opacity: 0.55;
  }

  .count {
    position: absolute;
    right: 3px;
    bottom: 3px;
    min-width: 18px;
    padding: 0 5px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    line-height: 18px;
    text-align: center;
    background: var(--accent);
    color: var(--on-accent);
  }

  .titles {
    display: none;
  }

  /* Wide enough for words: the still becomes a strip, with the titles under it. */
  @media (min-width: 640px) {
    .grid {
      gap: 6px;
    }

    .cell {
      aspect-ratio: auto;
      min-height: 112px;
    }

    .picture {
      bottom: auto;
      height: 52px;
      flex-direction: row;
    }

    .count {
      top: 32px;
      bottom: auto;
    }

    .titles {
      display: grid;
      gap: 3px;
      padding: 56px 6px 6px;
      font-size: 12px;
      line-height: 1.25;
    }

    .titles span {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    .titles time {
      font-weight: 600;
    }

    .titles .off {
      text-decoration: line-through;
      color: var(--muted);
    }
  }
</style>
