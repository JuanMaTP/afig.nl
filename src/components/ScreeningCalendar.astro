---
// A film page's month view (plan §5.7): one grid per month, weeks from Monday, like the agenda's. A day with
// screenings shows their times and links to that day in the list, where the cinemas, versions and tickets are.
import { formatDay, formatTime } from '../lib/format';
import type { GridDay, MonthGrid } from '../lib/month-grid';
import type { Showing } from '../lib/screenings';

interface Props {
  months: MonthGrid<Showing>[];
  /** The list view's address, which the days link into. */
  listUrl: string;
}

const { months, listUrl } = Astro.props;
const WEEKDAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
/** Times a cell can show; more show as "+2". */
const MAX_TIMES = 3;

/** What a screen reader says for a day: "Sat 3 Oct: 14:30 at Eye Filmmuseum, 19:15 at LAB111". */
function dayLabel(day: GridDay<Showing>): string {
  return `${formatDay(day.events[0]!.startsAt)}: ${day.events.map((s) => `${formatTime(s.startsAt)} at ${s.venueName}`).join(', ')}`;
}
---

<p class="hint">Pick a day to see its screenings.</p>
{
  months.map((month) => (
    <section class="month" aria-labelledby={`month-${month.key}`}>
      <h2 id={`month-${month.key}`}>{month.label}</h2>
      <div class="grid">
        {WEEKDAYS.map((weekday) => (
          <span class="weekday" aria-hidden="true">
            {weekday}
          </span>
        ))}
        {month.weeks.flat().map((day) => {
          if (!day) return <span class="cell blank" />;
          const classes = ['cell', { today: day.isToday, past: day.isPast }];
          if (day.events.length === 0) {
            return (
              <span class:list={classes}>
                <span class="number">{day.day}</span>
              </span>
            );
          }
          return (
            <a class:list={[...classes, 'has-screenings']} href={`${listUrl}#day-${day.key}`} aria-label={dayLabel(day)}>
              <span class="number">{day.day}</span>
              <span class="times" aria-hidden="true">
                {day.events.slice(0, MAX_TIMES).map((s) => (
                  <time datetime={s.startsAt}>{formatTime(s.startsAt)}</time>
                ))}
                {day.events.length > MAX_TIMES && <span class="more">+{day.events.length - MAX_TIMES}</span>}
              </span>
            </a>
          );
        })}
      </div>
    </section>
  ))
}

<style>
  .hint {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  .month h2 {
    margin: 22px 0 10px;
    font-family: var(--font-title);
    font-weight: 400;
    font-size: 21px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
  }

  .weekday {
    padding-bottom: 2px;
    font-size: 12px;
    text-align: center;
    color: var(--muted);
  }

  .cell {
    display: flex;
    flex-direction: column;
    min-height: 64px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    color: var(--text);
    text-decoration: none;
  }

  .cell.blank {
    border-color: transparent;
    background: transparent;
  }

  .cell.past {
    opacity: 0.5;
  }

  .cell.today {
    border-color: var(--text);
  }

  .number {
    font-size: 13px;
    font-weight: 600;
  }

  .has-screenings {
    border-color: var(--accent);
    background: var(--pill);
  }

  .has-screenings .number {
    color: var(--accent);
  }

  .times {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin-top: 2px;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
    color: var(--pill-text);
  }

  .more {
    color: var(--muted);
  }

  @media (min-width: 640px) {
    .cell {
      min-height: 84px;
      padding: 6px;
    }

    .times {
      font-size: 13px;
    }
  }
</style>
