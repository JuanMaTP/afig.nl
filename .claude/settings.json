{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ls *)",
      "Bash(npx astro check *)",
      "Bash(npx vitest *)",
      "Bash(npx drizzle-kit generate *)",
      "Bash(npx wrangler types *)",
      "Bash(npx wrangler d1 * --local *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npx wrangler deploy *)",
      "Bash(npx wrangler versions *)",
      "Bash(npx wrangler rollback *)",
      "Bash(npx wrangler secret *)",
      "Bash(npx wrangler d1 * --remote *)",
      "Bash(wrangler *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git am *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-writes.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for git writes"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ask-before-production.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for production changes"
          }
        ]
      }
    ]
  }
}
